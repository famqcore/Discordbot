# ---------------------------------------------------------------------------
# FAMQCORE Bot — переменные окружения
#
# Скопируйте этот файл в `.env` (в этой же папке src/app/) и заполните значения:
#     cp .env.example .env
#
# Файл `.env` не коммитится (см. .gitignore).
#
# Где взять ID каналов/ролей: Discord → Настройки → Расширенные → Режим разработчика,
# дальше правый клик по каналу/роли → «Копировать ID».
# ---------------------------------------------------------------------------

# Токен Discord-бота (обязательно).
# Где взять: https://discord.com/developers/applications
#   Applications → ваш бот → Bot → Reset Token → Copy
#
# ВАЖНО: в разделе Bot → Privileged Gateway Intents включите
#   - MESSAGE CONTENT INTENT  (иначе не работают команды с префиксом)
#   - SERVER MEMBERS INTENT   (иначе бот не видит участников)
TOKEN=YOUR_BOT_TOKEN_HERE

# ---------------------------------------------------------------------------
# ID объектов сервера (рекомендуется заполнить)
#
# Бот работает по ID — переименование каналов и ролей его не ломает.
# Если ID не задан, бот ищет объект по имени из config.py (запасной вариант).
# ---------------------------------------------------------------------------

# Категория, куда складываются тикеты
TICKETS_CATEGORY_ID=

# Роли
ROLE_APPLIED_ID=        # выдаётся при подаче заявки
ROLE_RECRUITER_ID=      # рекрутёр: доступ к тикетам, пинг, модерация AFK
ROLE_OWNER_ID=          # владелец: доступ к тикетам, пинг
ROLE_DEP_OWNER_ID=      # зам. владельца: доступ к тикетам, пинг
ROLE_ADMIN_ID=          # админ: доступ к тикетам
ROLE_SUPPORT_ID=        # саппорт: доступ к тикетам

# Голосовые каналы для кнопки «Вызвать на обзвон», через запятую,
# в том же порядке, что VOICE_CHANNELS в config.py
VOICE_CHANNEL_IDS=

# ---------------------------------------------------------------------------
# Лог-центр: один приватный канал с ветками по категориям
#
# Если ID не заданы — бот сам создаст приватный канал и 6 веток:
#   📝-заявки, ⚖️-решения, 🔴-afk, 🔊-обзвоны, 📊-статистика, 🚨-ошибки
# ---------------------------------------------------------------------------

LOG_CHANNEL_ID=
LOG_THREAD_TICKETS_ID=      # новые заявки
LOG_THREAD_DECISIONS_ID=    # решения по заявкам
LOG_THREAD_AFK_ID=          # установка/снятие AFK
LOG_THREAD_CALLS_ID=        # вызовы на обзвон
LOG_THREAD_STATS_ID=        # статистика
LOG_THREAD_ERRORS_ID=       # ошибки бота

# ---------------------------------------------------------------------------
# Прочее
# ---------------------------------------------------------------------------

# Как часто проверять истёкшие AFK, секунды (по умолчанию 60)
AFK_EXPIRY_CHECK_SECONDS=60
