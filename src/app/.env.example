# ---------------------------------------------------------------------------
# FAMQCORE Bot — переменные окружения
#
# Скопируйте этот файл в `.env` (в этой же папке src/app/) и заполните значения:
#     cp .env.example .env
#
# Файл `.env` не коммитится (см. .gitignore).
#
# Где взять ID каналов/ролей: Discord → Настройки → Расширенные → Режим разработчика,
# дальше правый клик по каналу/роли → «Копировать ID».
# ---------------------------------------------------------------------------

# Токен Discord-бота (обязательно).
# Где взять: https://discord.com/developers/applications
#   Applications → ваш бот → Bot → Reset Token → Copy
#
# ВАЖНО: в разделе Bot → Privileged Gateway Intents включите
#   - MESSAGE CONTENT INTENT  (иначе не работают команды с префиксом)
#   - SERVER MEMBERS INTENT   (иначе бот не видит участников)
TOKEN=YOUR_BOT_TOKEN_HERE

# ---------------------------------------------------------------------------
# ID объектов сервера
#
# Production-режим работает СТРОГО по ID: поиск объектов по имени выключен
# (имена в Discord не уникальны — одноимённая роль не должна получить доступ
# к тикетам и логам). Заданный, но не найденный ID останавливает запуск бота
# с понятным списком проблем — до обработки первой заявки.
#
# Незаполненные ID не фатальны:
#   - роль просто не участвует в доступах (deny by default),
#   - категория тикетов и лог-центр при необходимости создаются ботом
#     приватными автоматически (бот запоминает их ID),
#   - кнопка обзвона сообщит, что канал не найден.
# ---------------------------------------------------------------------------

# Категория, куда складываются тикеты
TICKETS_CATEGORY_ID=

# Роли
ROLE_APPLIED_ID=        # выдаётся при подаче заявки
ROLE_RECRUITER_ID=      # рекрутёр: доступ к тикетам, пинг, модерация AFK
ROLE_OWNER_ID=          # владелец: доступ к тикетам, пинг
ROLE_DEP_OWNER_ID=      # зам. владельца: доступ к тикетам, пинг
ROLE_ADMIN_ID=          # админ: доступ к тикетам
ROLE_SUPPORT_ID=        # саппорт: доступ к тикетам

# Голосовые каналы для кнопки «Вызвать на обзвон», через запятую,
# в том же порядке, что VOICE_CHANNELS в config.py
VOICE_CHANNEL_IDS=

# ---------------------------------------------------------------------------
# Лог-центр: один приватный канал с ветками по категориям
#
# Подключение к СУЩЕСТВУЮЩЕМУ каналу: задайте LOG_CHANNEL_ID (и, при желании,
# ID веток). Канал обязан быть приватным: @everyone без просмотра, доступ
# только у бота и стафф-ролей — иначе бот откажется туда писать (fail closed)
# и не запустится в production. ID веток задаются только вместе с
# LOG_CHANNEL_ID и должны принадлежать этому каналу.
#
# Оставьте всё пустым — бот сам создаст приватный лог-центр с ветками:
#   📝-заявки, ⚖️-решения, 🔴-afk, 🔊-обзвоны, 📊-статистика, 🚨-ошибки, 🧾-аудит
# ---------------------------------------------------------------------------

LOG_CHANNEL_ID=
LOG_THREAD_TICKETS_ID=      # новые заявки
LOG_THREAD_DECISIONS_ID=    # решения по заявкам
LOG_THREAD_AFK_ID=          # установка/снятие AFK
LOG_THREAD_CALLS_ID=        # вызовы на обзвон
LOG_THREAD_STATS_ID=        # статистика
LOG_THREAD_ERRORS_ID=       # ошибки бота
LOG_THREAD_AUDIT_ID=        # аудит: удаление данных, ретенция

# ---------------------------------------------------------------------------
# Хранение данных
# ---------------------------------------------------------------------------

# Срок хранения заявок и транскриптов в днях (по умолчанию 180).
# Просроченные записи удаляются фоновой задачей вместе с привязанными
# сообщениями лог-центра (docs/privacy.md).
TICKET_RETENTION_DAYS=180

# Как часто запускать очистку просроченных заявок, секунды (по умолчанию 86400)
RETENTION_CHECK_SECONDS=86400

# ---------------------------------------------------------------------------
# Прочее
# ---------------------------------------------------------------------------

# Как часто проверять истёкшие AFK, секунды (по умолчанию 60)
AFK_EXPIRY_CHECK_SECONDS=60

# ---------------------------------------------------------------------------
# НЕБЕЗОПАСНО. Только для локальной разработки. Не включайте в production.
#
# ALLOW_NAME_FALLBACK=true включает поиск ролей/каналов по ИМЕНИ (legacy-режим)
# и переводит проверки инфраструктуры из фатальных в предупреждения. Имена
# в Discord не уникальны: одноимённая роль может получить доступ к приватным
# тикетам и логам, а is_staff() — право на решения по заявкам и снятие AFK.
# ---------------------------------------------------------------------------
# ALLOW_NAME_FALLBACK=
